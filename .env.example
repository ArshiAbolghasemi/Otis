# --- Application ---
APP_NAME=otis

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=otis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=otis

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Inbound webhook auth ---
WEBHOOK_API_KEY=your-porsline-webhook-api-key

# --- Gmail SMTP ---
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USERNAME=your-account@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
GMAIL_SENDER=your-account@gmail.com
GMAIL_RESULT_SUBJECT=Your AI Farm result is ready
GMAIL_RESULT_BODY=Hello, your result for AI Farm is ready. Please find the output attached to this email. Regards, AI Farm
GMAIL_ERROR_SUBJECT=Your AI Farm request failed
GMAIL_ERROR_BODY=Hello, unfortunately an error occurred while processing your AI Farm request. Our team has been notified. Details:
