# --- Application ---
APP_NAME=otis

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=otis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=otis

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI Farm ---
# Main AI Farm directory: holds the script below and the from_user/to_user dirs.
AIFARM_ROOT=/media/ai/ssd/ahmadkalhor
# The script to run, inside AIFARM_ROOT.
AIFARM_SCRIPT_NAME=aifarm.py
# info.csv written into <AIFARM_ROOT>/from_user/data. Placeholders:
# {product_id}, {product_label}, {model_size}. Use \n for row breaks.
AIFARM_INFO_CSV_TEMPLATE=Product id ({product_label}):,{product_id}\nWhat size do you demand for the model?,"""{model_size}"""

# --- Object storage (S3-compatible: Cloudflare R2, MinIO, ...) ---
# Results are uploaded here and emailed as a pre-signed download link.
MINIO_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
MINIO_BUCKET=otis
MINIO_ACCESS_KEY=your-access-key-id
MINIO_SECRET_KEY=your-secret-access-key
# R2 has no regions; MinIO deployments may need a real one.
MINIO_REGION=auto
# How long the download link stays valid. 604800s (7 days) is the maximum.
MINIO_LINK_EXPIRY_SECONDS=604800

# --- Gmail SMTP ---
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_USERNAME=your-account@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
GMAIL_SENDER=your-account@gmail.com
GMAIL_RESULT_SUBJECT=Your AI Farm result is ready
# {download_link} and {expires_in} are filled in per result. Use \n for line breaks.
GMAIL_RESULT_BODY=Hello, your result for AI Farm is ready.\nYou can download it here (the link expires in {expires_in}):\n{download_link}\nRegards, AI Farm
GMAIL_ERROR_SUBJECT=Your AI Farm request failed
GMAIL_ERROR_BODY=Hello, unfortunately an error occurred while processing your AI Farm request. Our team has been notified. Details:
